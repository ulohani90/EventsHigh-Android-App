<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@color/day_selector_color"
    android:gravity="center_vertical|center_horizontal"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
>

    <TextView
        android:id="@+id/day_of_week"
        style="@style/DateButtonText"
        android:textColor="@color/day_selector_day_week_text"
        android:focusable="false"
        android:textSize="12sp"
        android:typeface="sans"
    />
    <TextView
        android:id="@+id/date"
        style="@style/DateButtonText"
        android:textColor="@color/day_selector_date_number_text"
        android:typeface="serif"
        android:textSize="18sp"
    />
    <TextView
        android:id="@+id/month"
        style="@style/DateButtonText"
        android:textColor="@color/day_selector_month_text"
        android:typeface="sans"
        android:textSize="12sp"
    />

</LinearLayout>
