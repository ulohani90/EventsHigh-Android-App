<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="108dp"
    android:layout_marginTop="4dp"
    android:foreground="?android:attr/selectableItemBackground"
>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/eh_background"
        android:scaleType="centerCrop"
        android:adjustViewBounds="false"
    />
    <TextView
        style="?android:attr/textAppearanceLarge"
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:drawableRight="@drawable/eh_myevents"
        android:drawableEnd="@drawable/eh_myevents"
        android:textColor="@android:color/white"
        android:fontFamily="sans-serif-medium"
        android:text="@string/ui_my_events"
    />
    <TextView
        style="?android:attr/textAppearanceSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:layout_margin="10dp"
        android:textSize="12sp"
        android:textColor="#CCFFFFFF"
        android:text="@string/ui_my_events_help"
    />
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_chevron_right_white_36dp"
        android:layout_gravity="center_vertical|end"
        android:layout_margin="8dp"
    />
</FrameLayout>
