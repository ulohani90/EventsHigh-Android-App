<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.eventshigh.nearme.app.activity.GuestDetailActivity"
    android:layout_width="match_parent"
    android:background="#EAEAEA"
    android:layout_height="match_parent">

        <ScrollView
                android:id="@+id/sv_guest_detail_cards"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingBottom="8dp"
                android:orientation="vertical">
                <LinearLayout
                        android:id="@+id/ll_guest_detail_layout_container"
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:paddingBottom="20dp"
                        android:orientation="vertical">
                </LinearLayout>
                <Button
                    android:id="@+id/btn_guest_detail_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Next"
                    android:textColor="@android:color/white"
                    android:background="@color/red_movie_text_color"
                    android:layout_gravity="bottom"
                    android:textSize="14dp"
                    android:padding="4dp"
                    style="?android:attr/borderlessButtonStyle"
                    />
            </LinearLayout>

        </ScrollView>
</FrameLayout>