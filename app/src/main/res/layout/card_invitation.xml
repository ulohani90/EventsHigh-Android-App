<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?android:attr/selectableItemBackground"
    android:descendantFocusability="blocksDescendants"
    tools:layout_width="280dp"
>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        tools:ignore="UselessParent"
    >
        <ImageView
            android:id="@+id/invite_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:adjustViewBounds="false"
            tools:src="@drawable/ic_launcher"
            tools:ignore="ContentDescription"
            />
        <TextView
            android:id="@+id/invite_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"

            android:layout_toRightOf="@id/invite_image"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#CC000000"
            android:textIsSelectable="false"
            tools:text="Arvind Batra has invited you to an event!"
        />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/invite_title"
            android:layout_toRightOf="@id/invite_image"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            android:textIsSelectable="false"
            android:gravity="center_vertical"
            android:textColor="#A3000000"
            android:textSize="13sp"
            tools:text="An awesome event @ the happening place, bangalore."
        />
        <TextView
            android:id="@+id/valid_before"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_below="@id/subtitle"
            android:layout_toRightOf="@id/invite_image"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            android:textIsSelectable="false"
            android:gravity="center_vertical"
            android:textSize="10sp"
            android:visibility="gone"
            />
    </RelativeLayout>
</FrameLayout>
