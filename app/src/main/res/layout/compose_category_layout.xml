<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/category_tag_parent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/category_selector_tag_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/category_name"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center"
        android:paddingLeft="12dp"
        android:paddingRight="8dp"
        android:text="Music"
        android:textColor="@color/event_time_text_selector"
        android:textSize="12sp" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@android:color/white" />

    <ImageView
        android:id="@+id/follow_img"
        android:layout_width="32dp"
        android:layout_height="33dp"
        android:scaleType="centerInside"
        android:src="@drawable/category_follow_selector_bg" />
</LinearLayout>