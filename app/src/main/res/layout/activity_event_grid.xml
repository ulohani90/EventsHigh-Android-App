<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:orientation="vertical"
    tools:context="com.eventshigh.nearme.app.activity.EventGridActivity"
>

    <TextView
        android:id="@+id/event_locality_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:text="@string/loading"
        android:textSize="@dimen/abc_text_size_body_1_material"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:background="@android:color/black"
        android:textColor="@android:color/white"
        android:drawableStart="@drawable/ic_action_location_found"
        android:drawableLeft="@drawable/ic_action_location_found"
        android:drawableEnd="@drawable/ic_action_edit"
        android:drawableRight="@drawable/ic_action_edit"
    />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@android:color/darker_gray"
    />

    <GridView
        android:id="@+id/event_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/abc_control_padding_material"
        android:columnWidth="@dimen/event_card_width"
        android:numColumns="auto_fit"
        android:stretchMode="columnWidth"
        android:gravity="center"
    />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
    >
        <LinearLayout
            android:id="@+id/daySelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:divider="?android:attr/listDivider"
            android:showDividers="middle"
        />
    </HorizontalScrollView>

</LinearLayout>
