<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="?android:attr/listPreferredItemHeight"
    android:orientation="vertical"
    android:background="@drawable/selector_touch"
    android:descendantFocusability="blocksDescendants"
>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:background="@drawable/selector_touch"
        android:descendantFocusability="blocksDescendants"
    >

        <ImageView
            android:id="@+id/event_bg"
            android:cacheColorHint="#00000000"
            android:src="@drawable/eh_default"
            android:background="@drawable/eh_default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
        />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/abc_control_padding_material"
            android:background="#33000000"
            android:layout_gravity="bottom"
        >

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
            >

                <TextView
                    android:id="@+id/event_venue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/abc_text_size_small_material"
                    android:maxLines="1"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:shadowColor="@android:color/black"
                    android:drawableStart="@drawable/ic_action_place"
                    android:drawableLeft="@drawable/ic_action_place"
                />

                <TextView
                    android:id="@+id/event_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/abc_text_size_small_material"
                    android:maxLines="1"
                    android:drawableStart="@drawable/ic_action_time"
                    android:drawableLeft="@drawable/ic_action_time"
                />

            </LinearLayout>

            <TextView
                android:id="@+id/num_people_interested"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableRight="@drawable/eh_popularity_score_icon"
                android:drawableEnd="@drawable/eh_popularity_score_icon"
                android:background="@android:color/transparent"
                android:textSize="@dimen/abc_text_size_body_1_material"
                android:gravity="bottom"
                android:textColor="@android:color/white"
                android:layout_marginRight="@dimen/abc_control_padding_material"
                android:layout_marginEnd="@dimen/abc_control_padding_material"
            />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/event_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/title_color"
        android:textSize="@dimen/abc_text_size_body_2_material"
        android:textStyle="bold"
        android:layout_margin="@dimen/abc_control_padding_material"
    />
</LinearLayout>
