<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/selector_touch"
    android:descendantFocusability="blocksDescendants"
>

    <ImageView
        android:id="@+id/event_bg"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/listPreferredItemHeightLarge"
        android:src="@drawable/eh_default"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription"
    />

    <ImageView
        android:id="@+id/event_share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@android:drawable/ic_menu_share"
        android:background="#66000000"
        android:layout_gravity="end|top"
        tools:ignore="ContentDescription"
    />

    <ImageView
        android:id="@+id/event_recommended"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/eh_recommend_icon"
        android:layout_gravity="start|top"
        tools:ignore="ContentDescription"
    />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#66000000"
        android:layout_gravity="bottom"
    >

        <TextView
            android:id="@+id/event_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="@dimen/abc_text_size_body_2_material"
            android:textStyle="bold"
            android:layout_margin="@dimen/abc_control_padding_material"
        />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
        >

            <TextView
                android:id="@+id/event_venue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textColor="@android:color/white"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="@dimen/abc_text_size_small_material"
                android:drawableStart="@drawable/ic_action_place"
                android:drawableLeft="@drawable/ic_action_place"
                android:gravity="center_vertical"
            />

            <TextView
                android:id="@+id/event_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textColor="@android:color/white"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="@dimen/abc_text_size_small_material"
                android:drawableStart="@drawable/ic_action_time"
                android:drawableLeft="@drawable/ic_action_time"
                android:gravity="center_vertical"
            />

            <TextView
                android:id="@+id/num_people_interested"
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textColor="@android:color/white"
                android:textSize="@dimen/abc_text_size_small_material"
                android:drawableStart="@drawable/eh_popularity_score_icon"
                android:drawableLeft="@drawable/eh_popularity_score_icon"
                android:gravity="center_vertical"
            />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>

