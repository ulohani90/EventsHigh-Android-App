<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ProgressBar
        android:id="@+id/top_progress_bar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-4dp"
        android:layout_marginTop="-4dp"
        android:indeterminate="true" />

    <com.eventshigh.nearme.app.view.AutofitRecyclerView
        android:id="@+id/explore_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:columnWidth="@dimen/explore_card_width"
        android:elevation="0dp"
        android:paddingBottom="20dp"
        android:verticalSpacing="2dp"
        tools:ignore="RtlHardcoded,UnusedAttribute"
        tools:listitem="@layout/card_explore" />


    <TextView
        android:id="@+id/verify_mobile_btn"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="#AA000000"
        android:drawableLeft="@drawable/ic_info_outline"
        android:drawablePadding="5dp"
        android:gravity="center_vertical"
        android:text="Verify your mobile number"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:visibility="gone" />


    <LinearLayout
        android:id="@+id/choose_city_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/close_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:padding="10dp"
                android:src="@drawable/ic_close_white_24dp" />

            <TextView
                style="?android:attr/textAppearanceMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="10dp"
                android:text="Select Localities"
                android:textColor="@android:color/white" />

            <ImageView
                android:id="@+id/accept_tick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:padding="10dp"
                android:src="@drawable/ic_done_white_24dp" />
        </LinearLayout>

        <ListView
            android:id="@+id/locality_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

        </ListView>
    </LinearLayout>
</FrameLayout>
