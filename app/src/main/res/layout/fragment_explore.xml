<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
>
    <ProgressBar
        android:id="@+id/top_progress_bar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-4dp"
        android:layout_marginTop="-4dp"
        android:indeterminate="true"
    />

    <com.eventshigh.nearme.app.view.AutofitRecyclerView
        android:id="@+id/explore_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:columnWidth="@dimen/explore_card_width"
        android:horizontalSpacing="2dp"
        android:verticalSpacing="2dp"
        android:paddingLeft="2dp"
        android:paddingTop="2dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:elevation="0dp"
        tools:listitem="@layout/card_explore"
        tools:ignore="RtlHardcoded,UnusedAttribute"
    />

    <LinearLayout
        android:id="@+id/choose_city_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:visibility="gone"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/close_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_close_white_24dp"/>
        <TextView
            android:id="@+id/choose_locality_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:padding="10dp"
            style="?android:attr/textAppearanceMedium"
            android:gravity="center"
            android:text="Select Localities"
            android:textColor="@android:color/white"
            />

            <ImageView
                android:id="@+id/accept_tick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_done_white_24dp"/>
        </LinearLayout>
    <ListView
        android:id="@+id/locality_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">

    </ListView>
    </LinearLayout>
</FrameLayout>
