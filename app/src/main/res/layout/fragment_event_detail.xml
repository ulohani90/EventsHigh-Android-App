<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".activity.EventDetailActivity"
>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
    >

        <LinearLayout
            android:id="@+id/share_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:orientation="vertical"
        >

            <!-- Event Image -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            >
                <com.android.volley.toolbox.NetworkImageView
                    android:id="@+id/event_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    tools:ignore="ContentDescription"
                    tools:src="@drawable/eh_default"
                />

                <ImageView
                    android:id="@+id/eh_recommend_banner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/eh_recommends_banner"
                    android:adjustViewBounds="true"
                    tools:ignore="ContentDescription"
                />
            </FrameLayout>

            <!-- Event Title -->
            <TextView
                android:id="@+id/event_title"
                style="?android:attr/textAppearanceLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/abc_action_bar_icon_vertical_padding_material"
                android:textSize="@dimen/abc_text_size_headline_material"
                android:textIsSelectable="true"
                tools:text="The Awesome Event"
            />

            <!-- Event Venue etc -->
            <TextView
                android:id="@+id/num_people_interested"
                style="@style/EventDetailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_action_person_dark"
                android:drawableLeft="@drawable/ic_action_person_dark"
                android:clickable="true"
                tools:text="32 people interested"
            />
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/abc_dropdownitem_text_padding_left"
            >
                <ImageView
                    android:id="@+id/event_venue_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_action_place_dark"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    tools:ignore="ContentDescription"
                />
                <TextView
                    android:id="@+id/event_venue"
                    style="@style/EventDetailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_toRightOf="@+id/event_venue_icon"
                    android:layout_toEndOf="@+id/event_venue_icon"
                    android:layout_toLeftOf="@+id/show_directions"
                    android:layout_toStartOf="@+id/show_directions"
                    android:textStyle="bold"
                    tools:text="Counter Culture"
                />
                <TextView
                    android:id="@+id/event_address"
                    style="@style/EventDetailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_below="@+id/event_venue"
                    android:layout_toRightOf="@+id/event_venue_icon"
                    android:layout_toEndOf="@+id/event_venue_icon"
                    android:layout_toLeftOf="@+id/show_directions"
                    android:layout_toStartOf="@+id/show_directions"
                    tools:text="Near Hoodi circle, Whitefield, Bangalore, 560037."
                />
                <TextView
                    android:id="@+id/show_directions"
                    style="@style/EventDetailButton"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="@string/action_direction"
                />
            </RelativeLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="@dimen/abc_dropdownitem_text_padding_left"
            android:background="@color/event_detail_gray"
        />

        <!-- Action Items -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
        >
            <View
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
            />

            <FrameLayout
                android:id="@+id/book_ticket"
                style="@style/EventDetailButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:padding="0dp"
                android:layout_margin="@dimen/abc_dropdownitem_text_padding_left"
            >
                <TextView
                    style="@style/EventDetailButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/action_book"
                    android:clickable="false"
                    android:drawableLeft="@drawable/action_book_it"
                    android:drawableStart="@drawable/action_book_it"
                />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/call"
                style="@style/EventDetailButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:padding="0dp"
                android:layout_margin="@dimen/abc_dropdownitem_text_padding_left"
            >
                <TextView
                    style="@style/EventDetailButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/action_call"
                    android:clickable="false"
                    android:drawableLeft="@android:drawable/sym_action_call"
                    android:drawableStart="@android:drawable/sym_action_call"
                />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/save"
                style="@style/EventDetailButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:padding="0dp"
                android:layout_margin="@dimen/abc_dropdownitem_text_padding_left"
            >
                <TextView
                    style="@style/EventDetailButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/action_save"
                    android:clickable="false"
                    android:drawableLeft="@android:drawable/ic_menu_my_calendar"
                    android:drawableStart="@android:drawable/ic_menu_my_calendar"
                />
            </FrameLayout>

            <View
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
            />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/event_detail_gray"
        />

        <!-- Event timings -->
        <TextView
            style="@style/EventDetailHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_event_timings"
        />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="horizontal"
            android:paddingLeft="@dimen/abc_dropdownitem_text_padding_left"
            android:paddingRight="@dimen/abc_dropdownitem_text_padding_left"
            android:paddingBottom="@dimen/abc_dropdownitem_text_padding_left"
            android:layout_marginBottom="@dimen/abc_dropdownitem_text_padding_left"
        >
            <LinearLayout
                android:id="@+id/event_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                tools:listitem="@layout/day_selector_item"
                tools:layout_height="30dp"
            />
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/event_detail_gray"
        />

        <!-- Event tags -->
        <TextView
            android:id="@+id/event_tags_header"
            style="@style/EventDetailHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_event_tags"
        />
        <LinearLayout
            android:id="@+id/event_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/abc_control_padding_material"
            android:paddingBottom="@dimen/abc_dropdownitem_text_padding_left"
            android:orientation="vertical"
            tools:listitem="@layout/event_tag"
        />

        <View
            android:id="@+id/event_tags_separator"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="@dimen/abc_dropdownitem_text_padding_left"
            android:background="@color/event_detail_gray"
        />

        <!-- Event Description -->
        <TextView
            style="@style/EventDetailHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_event_description"
        />
        <TextView
            android:id="@+id/event_description"
            style="@style/EventDetailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            tools:text="...\n,,,\n---"
        />
        <TextView
            android:id="@+id/event_from"
            style="@style/EventDetailText"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:textColor="@android:color/holo_purple"
            android:layout_marginTop="@dimen/abc_dropdownitem_text_padding_left"
            android:layout_marginBottom="@dimen/abc_dropdownitem_text_padding_left"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            tools:text="Event details from: www.eventshigh.com"
        />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="@dimen/abc_dropdownitem_text_padding_left"
            android:background="@color/event_detail_gray"
        />

        <!-- Organizer Info -->
        <TextView
            android:id="@+id/organizer_header"
            style="@style/EventDetailHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_organizer"
        />
        <LinearLayout
            android:id="@+id/organizer_name_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/abc_control_padding_material"
            android:paddingBottom="@dimen/abc_control_padding_material"
            android:orientation="horizontal"
        >
            <TextView
                style="@style/EventDetailText"
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/ui_name"
            />
            <TextView
                style="@style/EventDetailText"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text=":"
                tools:ignore="HardcodedText"
            />
            <TextView
                android:id="@+id/organizer_name"
                style="@style/EventDetailText"
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="2"
                tools:text="Counter Culture"
            />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/organizer_phone_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/abc_control_padding_material"
            android:paddingBottom="@dimen/abc_control_padding_material"
            android:orientation="horizontal"
        >
            <TextView
                style="@style/EventDetailText"
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/ui_phone"
            />
            <TextView
                style="@style/EventDetailText"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text=":"
                tools:ignore="HardcodedText"
            />
            <TextView
                android:id="@+id/organizer_phone"
                style="@style/EventDetailText"
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                tools:text="+91-9900439770"
            />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/organizer_website_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/abc_control_padding_material"
            android:paddingBottom="@dimen/abc_control_padding_material"
            android:orientation="horizontal"
        >
            <TextView
                style="@style/EventDetailText"
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/ui_website"
            />
            <TextView
                style="@style/EventDetailText"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text=":"
                tools:ignore="HardcodedText"
            />
            <TextView
                android:id="@+id/organizer_website"
                style="@style/EventDetailText"
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                tools:text="www.eventshigh.com"
            />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/abc_dropdownitem_icon_width"
            android:background="@android:color/transparent"
        />
    </LinearLayout>
</ScrollView>
