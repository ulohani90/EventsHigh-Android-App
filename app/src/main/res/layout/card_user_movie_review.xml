<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.eventshigh.nearme.app.view.CircularImageView
            android:id="@+id/civ_user_review"
            android:src="@drawable/zd_user_default_avatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_user_review_by"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:layout_marginTop="4dp"
                android:text="Movie Name"
                android:textColor="@color/red_movie_text_color"
                android:textSize="18sp" />

            <RatingBar
                android:id="@+id/rb_user_review_rating"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:isIndicator="false"
                android:progressDrawable="@drawable/movie_review_rating_bar"/>
        </LinearLayout>


    </LinearLayout>

    <TextView
        android:id="@+id/tv_user_review_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#2E2E2E"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="13sp" />

</LinearLayout>