<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_item_bg"
    android:descendantFocusability="blocksDescendants"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/reviewed_entity_image"
                android:layout_width="80dp"
                android:layout_height="64dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/reviewed_entity_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sens-serif-medium"
                    android:text="Lahe Lahe"
                    android:textColor="#343434"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/reviewed_entity_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#999999"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/reviewed_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#999999"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/reviewed_entity_add_fav"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_favorite_border_black_18dp" />

                <ImageView
                    android:id="@+id/reviewed_entity_remove_fav"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:scaleType="center"
                    android:src="@drawable/ic_favorite_red_18dp"
                    android:visibility="gone" />

            </FrameLayout>

            <ImageView
                android:id="@+id/reviewed_entity_share"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="center"
                android:src="@drawable/ic_share_grey_18dp" />


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_margin="8dp"
            android:background="#f0f0f0" />

        <TextView
            android:id="@+id/review_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:textColor="#878787"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_margin="8dp"
            android:background="#f0f0f0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Rating: "
                android:textAllCaps="true"
                android:textColor="#999999"
                android:textSize="14dp" />

            <RatingBar
                android:id="@+id/entity_rating"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:isIndicator="true"
                android:progressDrawable="@drawable/movie_rating_bar_draw"
                android:stepSize="0.2" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>