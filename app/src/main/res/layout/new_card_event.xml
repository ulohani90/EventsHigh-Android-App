<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_parent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical">

    <RelativeLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/offer_message_layout"
            android:background="#EFEFEF"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/event_time_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/event_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="SUN"
                    android:textColor="#393939"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/yellow_rectamgle_bg"
                    android:elevation="4dp">

                    <TextView
                        android:id="@+id/event_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="AUG 7"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/event_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7:30 AM"
                    android:textColor="#393939"
                    android:textSize="14sp" />

            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/event_bg"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/event_card_height"
                    android:layout_alignParentTop="true"
                    android:adjustViewBounds="false"
                    android:scaleType="centerCrop"
                    tools:ignore="ContentDescription" />


                <View
                    android:id="@+id/arrow"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/shape_triangle" />


                <TextView
                    android:id="@+id/event_venue"
                    style="@style/EventCardText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@id/event_bg"
                    android:background="@drawable/gradient_bg"
                    android:drawableStart="@drawable/ic_location_on_white_12dp"
                    android:paddingBottom="5dp"
                    android:paddingLeft="9dp"
                    android:paddingRight="5dp"
                    android:paddingTop="20dp"
                    android:textColor="#CCFFFFFF"
                    android:textIsSelectable="false"
                    android:textSize="13sp"

                    android:visibility="invisible"
                    tools:text="Jagriti theatre, Whitefield" />


                <ImageView
                    android:id="@+id/event_recommended"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginBottom="5dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/eh_recommend"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/trusted_partner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="-3dp"
                    android:src="@drawable/ic_trusted_list" />

                <TextView
                    android:id="@+id/is_sponsered_event"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@id/event_bg"
                    android:layout_marginBottom="8dp"
                    android:background="#CCFFFFFF"
                    android:drawableLeft="@drawable/ic_star_sponsored"
                    android:drawablePadding="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:padding="8dp"
                    android:text="SPONSORED"
                    android:textColor="#36889B"
                    android:textSize="10sp" />
            </RelativeLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/offer_message_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/green_filled_rectangle_bg"></LinearLayout>


            </LinearLayout>


            <TextView
                android:id="@+id/offer_message_text"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:drawableLeft="@drawable/ic_card_giftcard"
                android:drawablePadding="5dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:singleLine="true"
                android:ellipsize="none"
                android:text="Buy 3 Tickets, Get Rs 200 Off"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/offer_pointer_arrow"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/green_triangle_bg"
            android:rotation="180">

        </RelativeLayout>
    </RelativeLayout>

    <View
        android:id="@+id/info_arrow"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/shape_info_triangle"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/event_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/event_bg"
        android:background="@android:color/white"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/event_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#333333"
                    android:textIsSelectable="false"
                    android:textSize="18sp"
                    tools:text="My Awesome Event with a long long titl!" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/event_location"
                        style="@style/EventCardText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:layout_weight="1"
                        android:drawablePadding="5dp"
                        android:drawableStart="@drawable/ic_map_nav"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#666666"
                        android:textIsSelectable="false"
                        android:textSize="13sp"
                        tools:text="Just Truf's" />

                    <TextView
                        android:id="@+id/event_travel_time"
                        style="@style/EventCardText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_marginLeft="10dp"
                        android:drawablePadding="5dp"
                        android:drawableStart="@drawable/ic_local_taxi_grey_12dp"
                        android:textColor="#666666"
                        android:textIsSelectable="false"
                        android:textSize="13sp"
                        tools:text="30 mins" />
                </LinearLayout>

                <TextView
                    android:id="@+id/event_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingLeft="10dp"
                    android:textColor="#666666"
                    android:textIsSelectable="false"
                    android:textSize="16sp"
                    tools:text="₹ 200 - 500" />

                <TextView
                    android:id="@+id/event_discount"
                    style="@style/EventCardText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingLeft="10dp"
                    android:textColor="#CC40930B"
                    android:textIsSelectable="false"
                    android:textSize="14sp"
                    tools:text="10% Off" />
            </LinearLayout>

            <View
                android:id="@+id/event_time_separator"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp"
                android:background="#e1dfdf"></View>


        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#f0f0f0"></View>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_alignBottom="@+id/event_bg"
            android:background="@android:color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/stats_parent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.eventshigh.nearme.app.view.ContactListView
                        android:id="@+id/followed_by"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:clipChildren="false"
                        android:paddingLeft="18dp"
                        android:paddingRight="8dp"
                        android:visibility="gone"
                        app:contactPhotoSize="28dp"
                        app:contactPosition="start" />

                    <com.eventshigh.nearme.app.view.CircularImageView
                        android:id="@+id/img1"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="10dp"
                        android:scaleType="centerInside"
                        app:border="true"
                        app:border_color="@android:color/white"
                        app:border_width="1dp" />

                    <com.eventshigh.nearme.app.view.CircularImageView
                        android:id="@+id/img2"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="-10dp"
                        android:scaleType="centerInside"
                        app:border="true"
                        app:border_color="@android:color/white"
                        app:border_width="1dp" />

                    <TextView
                        android:id="@+id/event_stats"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:layout_weight="1"
                        android:drawablePadding="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:textIsSelectable="false"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:text="1049 views, 23 favourited" />


                </LinearLayout>
            </FrameLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#f0f0f0"></View>

            <ImageView
                android:id="@+id/share"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:background="@drawable/button_transparent_dark"
                android:padding="10dp"
                android:scaleType="center"
                android:src="@drawable/ic_share_grey_18dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#f0f0f0"></View>

            <ImageView
                android:id="@+id/action_favourite"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:layout_alignTop="@id/event_title"
                android:layout_gravity="center_vertical"
                android:padding="8dp"
                android:scaleType="center"
                android:src="@drawable/ic_favorite_red_18dp"
                tools:ignore="ContentDescription" />
        </LinearLayout>
    </LinearLayout>


</LinearLayout>
