<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".activity.LaunchActivity"
>
    <ViewSwitcher
        android:id="@+id/view_switcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
    >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
        >
            <include
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/toolbar"
            />
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:paddingBottom="10dp"
                android:clipToPadding="false"
            >
                <LinearLayout
                    android:id="@+id/explore_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp"
                >
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                    >
                        <android.support.v4.view.ViewPager
                            android:id="@+id/featured_events_pager"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                        />

                        <LinearLayout
                            android:id="@+id/dots_parent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_gravity="bottom"
                            android:orientation="horizontal"
                            android:layout_marginBottom="48dp"
                        />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="#D1E1E5"
                        android:elevation="4dp"
                        tools:ignore="UnusedAttribute"
                    >
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:padding="10dp"
                            android:gravity="center"
                            android:maxLines="1"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="15sp"
                            android:textColor="#798082"
                            android:text="@string/ui_today"
                            android:onClick="showToday"
                            tools:ignore="UnusedAttribute"
                        />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/shape_vertical_divider"
                        />

                        <TextView
                            style="?android:attr/textAppearanceMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:padding="10dp"
                            android:gravity="center"
                            android:maxLines="1"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="15sp"
                            android:textColor="#798082"
                            android:text="@string/ui_tomorrow"
                            android:onClick="showTomorrow"
                            tools:ignore="UnusedAttribute"
                        />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/shape_vertical_divider"
                        />

                        <TextView
                            style="?android:attr/textAppearanceMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:padding="10dp"
                            android:gravity="center"
                            android:maxLines="1"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="15sp"
                            android:textColor="#798082"
                            android:text="@string/ui_this_weekend"
                            android:onClick="showThisWeekend"
                            tools:ignore="UnusedAttribute"
                        />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/my_events_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                    >
                    </LinearLayout>

                    <TextView
                        android:id="@+id/featured_cat_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:textColor="#4E5B60"
                        android:textSize="14sp"
                        android:text="@string/featured_cat"
                        android:visibility="gone"
                    />
                    <LinearLayout
                        android:id="@+id/featured_cat_row1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                    />
                    <LinearLayout
                        android:id="@+id/featured_cat_row2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                    />
                    <LinearLayout
                        android:id="@+id/featured_cat_row3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                    />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:textColor="#4E5B60"
                        android:textSize="14sp"
                        android:text="@string/explore_cat"
                    />
                </LinearLayout>
            </ScrollView>

            <include
                android:id="@+id/verify_phone_container"
                layout="@layout/view_phone_snack_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
            />
        </LinearLayout>

        <ListView
            android:id="@+id/city_selector"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:listitem="@android:layout/simple_list_item_1"
        />
    </ViewSwitcher>
    <LinearLayout
        android:layout_width="@dimen/event_card_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@android:color/white"
    >
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/app_feature"
            android:adjustViewBounds="true"
            tools:ignore="ContentDescription"
        />
        <fragment
            android:id="@+id/preferences_all"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:name="com.eventshigh.nearme.app.activity.EHPreferenceFragment"
            tools:layout="@layout/view_loading"
        />
    </LinearLayout>
</android.support.v4.widget.DrawerLayout>
