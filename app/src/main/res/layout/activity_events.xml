<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".activity.EventsGridActivity"
>
    <ViewSwitcher
        android:id="@+id/view_switcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
    >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
        >
            <RelativeLayout
                android:id="@+id/follow_widget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
            >
                <TextView
                    android:id="@+id/follow_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toLeftOf="@+id/following_button"
                    android:layout_toStartOf="@+id/following_button"
                    android:layout_margin="10dp"
                    android:textSize="16sp"
                    android:textColor="#CC000000"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_gravity="start|center_vertical"
                />
                <TextView
                    android:id="@+id/following_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_margin="10dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/selector_oval"
                    android:drawableStart="@drawable/ic_done_white_12dp"
                    android:drawableLeft="@drawable/ic_done_white_12dp"
                    android:drawablePadding="4dp"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:text="@string/ui_following"
                />
                <TextView
                    android:id="@+id/follow_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_margin="10dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/selector_oval"
                    android:drawablePadding="4dp"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:text="@string/ui_follow"
                />
            </RelativeLayout>

            <com.example.android.common.view.SlidingTabLayout
                android:id="@+id/date_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="8dp"
                android:background="#FBFBFB"
                tools:ignore="UnusedAttribute"
            />
            <com.example.android.common.view.SlidingTabLayout
                android:id="@+id/sliding_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="8dp"
                android:background="@android:color/black"
                tools:ignore="UnusedAttribute"
            />
            <ProgressBar
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:id="@+id/top_progress_bar"
                android:indeterminate="true"
                android:layout_marginTop="-4dp"
                android:layout_marginBottom="-4dp"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            />
            <android.support.v4.view.ViewPager
                android:id="@+id/pager"
                android:layout_width="match_parent"
                android:layout_height="0px"
                android:layout_weight="1"
            />
        </LinearLayout>

        <include
            layout="@layout/view_retry"
        />
    </ViewSwitcher>

    <ImageButton
        android:id="@+id/fab_switch_view"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:background="@drawable/fab"
        android:elevation="4dp"
        android:padding="16dp"
        android:scaleType="fitXY"
        android:onClick="onSwitchView"
        android:scaleX="1"
        android:scaleY="1"
        android:src="@drawable/ic_map_white_36dp"
        tools:ignore="UnusedAttribute"
    />

    <include layout="@layout/verify_phone_snack_bar" />

</FrameLayout>
