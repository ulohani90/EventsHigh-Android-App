<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".activity.EventsGridActivity"
>
    <include
        android:id="@+id/view_no_my_event"
        layout="@layout/view_no_my_event"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
    />

    <include
        android:id="@+id/view_retry"
        layout="@layout/view_retry"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
    />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >

            <include
                android:id="@+id/toolbar"
                layout="@layout/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />

            <com.example.android.common.view.SlidingTabLayout
                android:id="@+id/date_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FBFBFB"
                android:elevation="8dp"
                tools:ignore="UnusedAttribute"
                />

            <ProgressBar
                android:id="@+id/top_progress_bar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="-4dp"
                android:layout_marginTop="-4dp"
                android:indeterminate="true"
                />

            <FrameLayout
                android:id="@+id/event_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                />

            <include
                android:id="@+id/verify_phone_container"
                layout="@layout/view_phone_snack_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible"
                />

            <RelativeLayout
                android:id="@+id/my_events_clue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/eh_button_cta"
                android:visibility="gone"
                tools:visibility="visible"
                >
                <ImageView
                    android:id="@+id/my_events_cup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:layout_margin="8dp"
                    android:src="@drawable/eh_myevents"
                    />
                <TextView
                    android:id="@+id/my_events_clue_text"
                    style="?android:attr/textAppearanceSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/my_events_cup"
                    android:layout_toLeftOf="@+id/my_events_clue_close"
                    android:layout_toRightOf="@+id/my_events_cup"
                    android:layout_toStartOf="@+id/my_events_clue_close"
                    android:text="@string/ui_my_events_clue"
                    android:textColor="@android:color/white"
                    />
                <ImageButton
                    android:id="@+id/my_events_clue_close"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/button_transparent_dark"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    />
            </RelativeLayout>
        </LinearLayout>

        <View
            android:id="@+id/follow_toolbar_background"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:background="@color/primary"
            android:elevation="8dp"
            android:visibility="gone"
            />

        <include
            android:id="@+id/follow_toolbar"
            layout="@layout/follow_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />

    </FrameLayout>
</FrameLayout>

