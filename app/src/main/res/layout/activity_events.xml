<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    tools:context=".activity.EventsGridActivity"
>
    <LinearLayout
        android:id="@+id/follow_widget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:elevation="8dp"
        tools:ignore="UnusedAttribute"
    >
        <TextView
            android:id="@+id/follow_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textColor="#CC000000"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_gravity="start|center_vertical"
            tools:text="Music"
        />
        <TextView
            android:id="@+id/following_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/shape_oval"
            android:drawableStart="@drawable/ic_done_white_12dp"
            android:drawableLeft="@drawable/ic_done_white_12dp"
            android:drawablePadding="4dp"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:text="@string/ui_following"
        />
        <TextView
            android:id="@+id/follow_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/shape_oval"
            android:drawablePadding="4dp"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:text="@string/ui_follow"
        />
    </LinearLayout>

    <com.example.android.common.view.SlidingTabLayout
        android:id="@+id/date_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        android:background="#FBFBFB"
        tools:ignore="UnusedAttribute"
    />
    <ProgressBar
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:id="@+id/top_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:layout_marginBottom="-4dp"
        android:indeterminate="true"
    />
    <ViewSwitcher
        android:id="@+id/view_switcher"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
    >
        <FrameLayout
            android:id="@+id/event_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
        >
            <ImageButton
                android:id="@+id/fab_switch_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:padding="16dp"
                android:background="@drawable/selector_fab"
                android:elevation="4dp"
                android:onClick="onSwitchView"
                android:src="@drawable/ic_place_white_36dp"
                tools:ignore="UnusedAttribute"
            />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
        >
            <include
                android:id="@+id/view_no_my_event"
                layout="@layout/view_no_my_event"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
            />
            <include
                android:id="@+id/view_retry"
                layout="@layout/view_retry"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
            />
        </FrameLayout>
    </ViewSwitcher>

    <include
        android:id="@+id/verify_phone_container"
        layout="@layout/view_phone_snack_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
    />
</LinearLayout>
