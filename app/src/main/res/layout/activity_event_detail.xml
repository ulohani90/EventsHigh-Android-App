<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:tools="http://schemas.android.com/tools"
                xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".activity.EventDetailActivity"
>
    <android.support.design.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <android.support.design.widget.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        >
            <android.support.design.widget.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:contentScrim="?attr/colorPrimary"
                android:fitsSystemWindows="true"
                app:expandedTitleMarginStart="24dp"
                app:expandedTitleMarginEnd="24dp"
                app:expandedTitleMarginBottom="24dp"
                app:expandedTitleTextAppearance="@style/TextAppearance.AppCompat.Headline"
                app:layout_scrollFlags="scroll|exitUntilCollapsed"
            >
                <FrameLayout
                    android:id="@+id/frame_parent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visiblity="visible"
                    app:layout_collapseMode="parallax"
                >
                    <ImageView
                        android:id="@+id/event_bg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop"
                        android:onClick="imagePreview"
                        android:transitionName="event_bg"
                        tools:ignore="ContentDescription,UnusedAttribute"
                        tools:layout_height="150dp"
                        tools:background="@drawable/eh_default_event"
                    />
                    <ImageView
                        android:id="@+id/eh_recommends"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_margin="16dp"
                        android:src="@drawable/eh_recommend"
                        android:adjustViewBounds="true"
                        android:transitionName="eh_recommends"
                        tools:ignore="ContentDescription,UnusedAttribute"
                    />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/shape_film"
                    />
                    <ImageView
                        android:id="@+id/play_youtube"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_play_circle_filled_black_48dp"
                        android:clickable="true"
                        android:onClick="playYouTube"
                        tools:ignore="ContentDescription,UnusedAttribute"
                    />
                </FrameLayout>

                <android.support.v7.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:popupTheme="@style/ThemeOverlay.AppCompat.Light"
                    android:title="Collapsing Toolbar"
                    android:background="@android:color/transparent"
                    app:layout_collapseMode="pin"
                    tools:ignore="UnusedAttribute"
                >

            </android.support.v7.widget.Toolbar>
        </android.support.design.widget.CollapsingToolbarLayout>

        </android.support.design.widget.AppBarLayout>
        <android.support.v4.widget.NestedScrollView
            android:id="@+id/event_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/action_footer"
            android:clipToPadding="false"
            android:visibility="gone"
            tools:visibility="visible"
            android:fitsSystemWindows="true"
            android:paddingBottom="64dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
        >
            <LinearLayout
                android:id="@+id/event_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                tools:ignore="WebViewLayout"
            >
                <!-- Stats -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1a4d4d4d"
                />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                >
                    <TextView
                        android:id="@+id/event_stats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="18dp"
                        android:textStyle="bold"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:drawableStart="@drawable/ic_person_black_18dp"
                        android:drawablePadding="4dp"
                        android:textIsSelectable="false"
                        tools:text="1049 views, 23 favourited"
                    />
                    <com.eventshigh.nearme.app.view.ContactListView
                        android:id="@+id/followed_by"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:padding="18dp"
                        app:contactPhotoSize="24dp"
                        app:contactPosition="start"
                        app:text=" ♥ (like) this."
                    />
                </LinearLayout>

                <!-- Invitations -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1a4d4d4d"
                />
                <com.eventshigh.nearme.app.view.ContactListView
                    android:id="@+id/invited_by"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:visibility="gone"
                    app:contactPhotoSize="24dp"
                    app:contactPosition="start"
                />

                <!-- EH Actions -->
                <LinearLayout
                    android:id="@+id/action_button_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/button_gray"
                >
                    <TextView
                        android:id="@+id/action_favourite"
                        style="@style/EHDetailActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawableTop="@drawable/ic_favorite_grey600_24dp"
                        android:clickable="true"
                        android:onClick="addFavourite"
                        android:text="@string/ui_favourite"
                        android:transitionName="action_favourite"
                        tools:ignore="UnusedAttribute"
                    />
                    <TextView
                        android:id="@+id/action_favourited"
                        style="@style/EHDetailActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawableTop="@drawable/ic_favorite_red_24dp"
                        android:clickable="true"
                        android:onClick="removeFavourite"
                        android:text="@string/ui_favourited"
                        android:visibility="gone"
                    />
                    <TextView
                        style="@style/EHDetailActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawableTop="@drawable/ic_event_grey600_24dp"
                        android:clickable="true"
                        android:onClick="save"
                        android:text="@string/action_calendar"
                    />
                    <TextView
                        style="@style/EHDetailActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawableTop="@drawable/ic_directions_grey600_24dp"
                        android:clickable="true"
                        android:onClick="showDirections"
                        android:text="@string/action_direction"
                    />
                    <TextView
                        style="@style/EHDetailActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawableTop="@drawable/ic_help_grey600_24dp"
                        android:clickable="true"
                        android:onClick="ama"
                        android:text="@string/action_ama"
                    />
                </LinearLayout>

                <!-- Event Venue -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1a4d4d4d"
                />
                <RelativeLayout
                    android:id="@+id/venue_group"
                    style="@style/EHButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:onClick="showVenue"
                >
                    <ImageView
                        android:id="@+id/event_venue_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:src="@drawable/ic_location_on_grey600_24dp"
                        tools:ignore="ContentDescription"
                    />
                    <TextView
                        android:id="@+id/event_venue"
                        style="@style/EHText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_toEndOf="@+id/event_venue_icon"
                        android:layout_toStartOf="@+id/event_travel_time"
                        android:textColor="#A3000000"
                        android:textIsSelectable="false"
                        android:transitionName="event_venue"
                        tools:ignore="UnusedAttribute"
                        tools:text="Counter Culture"
                    />
                    <TextView
                        android:id="@+id/event_address"
                        style="@style/EHText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/event_venue"
                        android:layout_toEndOf="@+id/event_venue_icon"
                        android:layout_toStartOf="@+id/event_travel_time"
                        android:textColor="#999197A3"
                        android:textIsSelectable="false"
                        tools:text="Whitefield, Bangalore."
                    />
                    <TextView
                        android:id="@+id/event_travel_time"
                        style="@style/EHText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:textColor="#999197A3"
                        android:drawableTop="@drawable/ic_local_taxi_grey600_12dp"
                        android:drawablePadding="4dp"
                        android:transitionName="event_travel_time"
                        android:textIsSelectable="false"
                        tools:ignore="UnusedAttribute"
                        tools:text="30 min"
                    />
                </RelativeLayout>

                <!-- Event Time -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1a4d4d4d"
                />
                <LinearLayout
                    android:id="@+id/event_time_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:animateLayoutChanges="true"
                    android:background="@color/button_gray"
                >
                    <RelativeLayout
                        android:id="@+id/event_time_first"
                        style="@style/EHButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:onClick="save"
                    >
                        <ImageView
                            android:id="@+id/event_time_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentBottom="true"
                            android:src="@drawable/ic_access_time_grey600_24dp"
                            tools:ignore="ContentDescription"
                        />
                        <TextView
                            android:id="@+id/event_time"
                            style="@style/EHText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true"
                            android:layout_toEndOf="@+id/event_time_icon"
                            android:textColor="#A3000000"
                            android:textIsSelectable="false"
                            android:transitionName="event_time"
                            tools:ignore="UnusedAttribute"
                            tools:text="Wed, 14 Jan at 9:30 AM"
                        />
                        <TextView
                            android:id="@+id/event_time_details"
                            style="@style/EHText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@+id/event_time_icon"
                            android:layout_below="@+id/event_time"
                            android:textColor="#999197A3"
                            android:textIsSelectable="false"
                            tools:text="2 days from now"
                        />
                    </RelativeLayout>
                    <TextView
                        android:id="@+id/also_on"
                        style="@style/EHButton"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:textColor="#80000000"
                        android:text="@string/ui_also_on"
                        android:textAllCaps="false"
                    />
                    <HorizontalScrollView
                        android:id="@+id/event_future_times_hs"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:scrollbars="none"
                        android:visibility="gone"
                    >
                        <LinearLayout
                            android:id="@+id/event_future_times"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:showDividers="middle"
                            android:divider="@drawable/shape_vertical_divider"
                            android:orientation="horizontal"
                        />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Action Items -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1a4d4d4d"
                />
                <FrameLayout
                    android:id="@+id/call"
                    style="@style/EHButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:onClick="call"
                >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:drawableStart="@drawable/action_call"
                        android:textColor="#CC000000"
                        android:text="@string/action_call"
                    />
                </FrameLayout>

                <!-- Price -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1a4d4d4d"
                />
                <TextView
                    android:id="@+id/event_title"
                    style="?android:attr/textAppearanceMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginEnd="16dp"
                    android:textIsSelectable="true"
                    android:textColor="#CC000000"
                    android:transitionName="event_title"
                    tools:ignore="UnusedAttribute"
                    tools:text="The Awesome Event"
                    />
                <LinearLayout
                    android:id="@+id/price_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                >
                    <TextView
                        style="@style/EHHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="18dp"
                        android:textAllCaps="true"
                        android:textColor="#CC383F3F"
                        android:text="@string/ui_price"
                    />
                    <TextView
                        style="@style/EHText"
                        android:id="@+id/event_price"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="18dp"
                        android:gravity="start"
                        android:textColor="#CC383F3F"
                        android:textIsSelectable="false"
                        tools:ignore="UnusedAttribute"
                        tools:text="₹ 200 - 500"
                    />
                </LinearLayout>

                <!-- Performers Info -->
                <TextView
                    android:id="@+id/performer_header"
                    style="@style/EHHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:textAllCaps="true"
                    android:textColor="#CC383F3F"
                    android:text="@string/ui_performer"
                />
                <LinearLayout
                    android:id="@+id/performers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="vertical"
                />

                <!-- Event tags -->
                <TextView
                    android:id="@+id/tags_header"
                    style="@style/EHHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:textAllCaps="true"
                    android:textColor="#CC383F3F"
                    android:text="@string/ui_categories"
                />
                <LinearLayout
                    android:id="@+id/event_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="vertical"
                />

                <!-- Event Description -->
                <TextView
                    android:id="@+id/description_header"
                    style="@style/EHHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:textAllCaps="true"
                    android:textColor="#CC383F3F"
                    android:text="@string/ui_description"
                />
                <WebView
                    android:id="@+id/event_description"
                    style="@style/EHText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="true"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="8dp"
                    android:textColor="#CC383F3F"
                    android:hardwareAccelerated="true"
                />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:id="@+id/youtube_fragment"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
                <TextView
                    android:id="@+id/event_from"
                    style="@style/EHText"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:layout_marginEnd="16dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:layout_gravity="end"
                    android:textColor="#99A7A9AC"
                    android:onClick="openSourceSite"
                    tools:text="Event details from: www.eventshigh.com"
                />

                <!-- Organizer Info -->
                <TextView
                    android:id="@+id/organizer_header"
                    style="@style/EHHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:textAllCaps="true"
                    android:textColor="#CC383F3F"
                    android:text="@string/ui_organizer"
                />
                <LinearLayout
                    android:id="@+id/organizer_name_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="8dp"
                >
                    <TextView
                        style="@style/EHText"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textColor="#CC222222"
                        android:text="@string/ui_name"
                    />
                    <TextView
                        android:id="@+id/organizer_name"
                        style="@style/EHText"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textColor="#CC222222"
                        android:textIsSelectable="true"
                        tools:text="Counter Culture"
                    />
                </LinearLayout>
                <TextView
                    android:id="@+id/organizer_link"
                    style="@style/EHText"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/link_color"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:onClick="openOrganizerLink"
                    tools:text="parag@eventshigh.com"
                />
                <LinearLayout
                    android:id="@+id/organizer_email_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="8dp"
                >
                    <TextView
                        style="@style/EHText"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textColor="#CC222222"
                        android:text="@string/ui_email"
                    />
                    <TextView
                        android:id="@+id/organizer_email"
                        style="@style/EHText"
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:textColor="@color/link_color"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:textIsSelectable="true"
                        tools:text="parag@eventshigh.com"
                    />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/organizer_phone_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="8dp"
                >
                    <TextView
                        style="@style/EHText"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textColor="#CC222222"
                        android:text="@string/ui_phone"
                    />
                    <TextView
                        android:id="@+id/organizer_phone"
                        style="@style/EHText"
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:textColor="@color/link_color"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:textIsSelectable="true"
                        android:onClick="call"
                        tools:text="+91-9900439770"
                    />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/organizer_website_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="8dp"
                >
                    <TextView
                        style="@style/EHText"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textColor="#CC222222"
                        android:text="@string/ui_website"
                    />
                    <TextView
                        android:id="@+id/organizer_website"
                        style="@style/EHText"
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:textColor="@color/link_color"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:textIsSelectable="true"
                        android:onClick="openOrganizerWebsite"
                        tools:text="www.eventshigh.com"
                    />
                </LinearLayout>

                <com.google.android.gms.plus.PlusOneButton
                    xmlns:plus="http://schemas.android.com/apk/lib/com.google.android.gms.plus"
                    android:id="@+id/plus_one_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    plus:size="standard"
                    plus:annotation="inline"
                />
            </LinearLayout>
        </android.support.v4.widget.NestedScrollView>
    </android.support.design.widget.CoordinatorLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp"
            android:showDividers="middle"
            android:background="@android:color/white"
            android:layout_alignParentBottom="true"
            android:divider="@drawable/shape_vertical_divider">
            <ImageView
                android:id="@+id/share_whatsapp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="12dp"
                android:elevation="4dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/whatsapp_24dp"
                android:background="@drawable/button_whatsapp"
                android:onClick="whatsapp"
                android:visibility="gone"
                tools:visibility="gone"
                tools:ignore="ContentDescription,UnusedAttribute"
            />
            <TextView
                android:id="@+id/check_with_friends"
                style="@style/EHButtonCTA"
                android:background="@drawable/eh_button_invite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:gravity="center"
                android:elevation="4dp"
                android:text="@string/action_share"
                android:onClick="checkWithFriends"
                android:visibility="gone"
                tools:visibility="visible"
                tools:ignore="UnusedAttribute"
            />
            <TextView
                android:id="@+id/book_ticket"
                style="@style/EHButtonCTA"
                android:background="@drawable/eh_button_book"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:layout_gravity="center"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:elevation="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/action_book"
                android:onClick="openBookingSite"
                android:visibility="gone"
                tools:visibility="visible"
                tools:ignore="UnusedAttribute"
            />
            <TextView
                android:id="@+id/join_event"
                style="@style/EHButtonCTA"
                android:background="@drawable/eh_button_book"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:layout_gravity="center"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:elevation="4dp"
                android:text="@string/action_join"
                android:onClick="openSourceSite"
                android:visibility="gone"
                tools:visibility="visible"
                tools:ignore="UnusedAttribute"
            />
        </LinearLayout>


    <ProgressBar
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:id="@+id/top_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="?android:attr/actionBarSize"
        android:indeterminate="true"
        tools:visibility="gone"
    />
</RelativeLayout>
