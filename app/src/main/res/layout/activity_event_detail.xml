<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".activity.EventDetailActivity"
>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
    >

        <!-- Event Image -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
        >
            <ImageView
                android:id="@+id/event_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                tools:ignore="ContentDescription"
                tools:src="@drawable/eh_default"
            />

            <ImageView
                android:id="@+id/eh_recommend_banner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/eh_recommends_banner"
                android:adjustViewBounds="true"
                tools:ignore="ContentDescription"
            />
        </FrameLayout>

        <!-- Event Title -->
        <TextView
            android:id="@+id/event_title"
            style="?android:attr/textAppearanceLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/abc_action_bar_icon_vertical_padding_material"
            android:textSize="@dimen/abc_text_size_headline_material"
            android:textIsSelectable="true"
            tools:text="The Awesome Event"
        />

        <!-- Event Venue etc -->
        <TextView
            android:id="@+id/num_people_interested"
            style="@style/EventDetailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_action_person_dark"
            android:drawableLeft="@drawable/ic_action_person_dark"
            tools:text="32 people interested"
        />
        <TextView
            android:id="@+id/event_venue"
            style="@style/EventDetailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/selector_event_text"
            android:drawableStart="@drawable/ic_action_place_dark"
            android:drawableLeft="@drawable/ic_action_place_dark"
            android:clickable="true"
            tools:text="CMH Road, Indira nagar, Bangalore"
        />

        <!-- Directions Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/event_detail_gray"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/abc_dropdownitem_text_padding_left"
            android:padding="@dimen/abc_dropdownitem_text_padding_left"
            >
            <View
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
            />
            <TextView
                android:id="@+id/buttonDirection"
                style="@style/EventDetailText"
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="3"
                android:gravity="center"
                android:background="@color/app_color"
                android:text="@string/action_direction"
                android:textColor="@android:color/white"
                android:clickable="true"
                android:padding="@dimen/abc_dropdownitem_text_padding_left"
            />
            <View
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
            />
        </LinearLayout>

        <!-- Event timings -->
        <TextView
            style="@style/EventDetailHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_event_timings"
        />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="horizontal"
            android:paddingLeft="@dimen/abc_action_bar_icon_vertical_padding_material"
            android:paddingRight="@dimen/abc_action_bar_icon_vertical_padding_material"
            android:paddingBottom="@dimen/abc_control_padding_material"
        >
            <LinearLayout
                android:id="@+id/event_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:divider="?android:attr/listDivider"
                android:showDividers="middle"
                android:dividerPadding="@dimen/abc_action_bar_icon_vertical_padding_material"
                tools:listitem="@layout/day_selector_item"
                tools:layout_height="30dp"
            />
        </HorizontalScrollView>

        <!-- Event tags -->
        <TextView
            style="@style/EventDetailHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/event_detail_gray"
            android:text="@string/ui_event_tags"
        />
        <LinearLayout
            android:id="@+id/event_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/event_detail_gray"
            android:paddingTop="@dimen/abc_control_padding_material"
            android:paddingBottom="@dimen/abc_control_padding_material"
            android:columnWidth="100dp"
            android:orientation="vertical"
            tools:listitem="@layout/event_tag"
        />

        <!-- Event Description -->
        <TextView
            style="@style/EventDetailHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_event_description"
        />
        <TextView
            android:id="@+id/event_description"
            style="@style/EventDetailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            tools:text="...\n,,,\n---"
        />

        <!-- Event Description -->
        <TextView
            android:id="@+id/event_from"
            style="@style/EventDetailText"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:background="@drawable/selector_event_text"
            android:textColor="@android:color/holo_purple"
            android:layout_marginTop="@dimen/abc_dropdownitem_icon_width"
            android:layout_marginBottom="@dimen/abc_dropdownitem_icon_width"
            android:clickable="true"
            android:onClick="openSourceSite"
            tools:text="Event details from: www.eventshigh.com"
        />

    </LinearLayout>
</ScrollView>
