<android.support.design.widget.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="192dp">

    <android.support.design.widget.CollapsingToolbarLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/app_name"
        android:id="@+id/toolbar_parent"
        app:contentScrim="@color/primary"
        app:collapsedTitleTextAppearance="@style/text_ToolbarCollapsedTitle"
        app:expandedTitleTextAppearance="@style/text_ToolbarExpandedTitle"
        app:layout_scrollFlags="scroll|exitUntilCollapsed">

        <!-- Event Image -->
        <FrameLayout
            app:layout_collapseMode="parallax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <com.eventshigh.nearme.app.view.FadeInNetworkImageView
                android:id="@+id/event_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:onClick="imagePreview"
                android:transitionName="event_bg"
                tools:ignore="UnusedAttribute"
                />
            <ImageView
                android:id="@+id/eh_recommends"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginLeft="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="48dp"
                android:src="@drawable/eh_recommend"
                android:adjustViewBounds="true"
                android:transitionName="eh_recommends"
                android:visibility="gone"
                tools:ignore="UnusedAttribute, ContentDescription"
                />
        </FrameLayout>


        <android.support.v7.widget.Toolbar
            app:theme="@style/EHActionBarDark"
            app:subtitleTextAppearance="@style/EHActionBarSubtitle"
            app:navigationContentDescription="@string/abc_action_bar_up_description"
            app:navigationIcon="@drawable/ic_arrow_back_white_24dp"
            android:elevation="8dp"
            tools:ignore="UnusedAttribute"
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_collapseMode="pin"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    </android.support.design.widget.CollapsingToolbarLayout>

</android.support.design.widget.AppBarLayout>
