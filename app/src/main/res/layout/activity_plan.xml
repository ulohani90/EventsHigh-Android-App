<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    tools:context=".activity.PlanActivity"
>
    <ProgressBar
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:id="@+id/top_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:indeterminate="true"
        android:visibility="gone"
    />

    <com.eventshigh.nearme.app.view.AutofitRecyclerView
        android:id="@+id/contact_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnWidth="92dp"
        android:horizontalSpacing="0dp"
        android:verticalSpacing="0dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
    />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:padding="6dp"
    >
        <TextView
            android:id="@+id/invite_button"
            style="@style/EHButtonCTA"
            android:background="@drawable/eh_button_invite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:elevation="4dp"
            android:text="@string/action_check_friends"
            android:onClick="invite"
            android:enabled="false"
            tools:ignore="UnusedAttribute"
        />
    </FrameLayout>
</LinearLayout>
