<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?android:attr/selectableItemBackground"
    android:descendantFocusability="blocksDescendants"
    card_view:cardCornerRadius="2dp"
    >
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <com.android.volley.toolbox.NetworkImageView
            android:id="@+id/event_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/big_event_card_image_height"
            android:scaleType="centerCrop"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_centerVertical="true"
            android:adjustViewBounds="false"
            tools:background="@color/gray400"
            />

        <ImageView
            android:id="@+id/event_recommended"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_alignBottom="@+id/event_bg"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/eh_recommend"
            tools:ignore="ContentDescription"
            />

        <ImageView
            android:id="@+id/event_offer_marker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/event_recommended"
            android:layout_toEndOf="@+id/event_recommended"
            android:layout_alignBottom="@+id/event_bg"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_local_offer_white_16dp"
            tools:ignore="ContentDescription"
            />

        <TextView
            android:id="@+id/num_people_interested"
            style="@style/EventCardText"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_alignBottom="@+id/event_bg"
            android:layout_alignRight="@+id/event_bg"
            android:layout_alignEnd="@+id/event_bg"
            android:textColor="@android:color/white"
            android:drawableStart="@drawable/ic_person_white_12dp"
            android:drawableLeft="@drawable/ic_person_white_12dp"
            android:layout_marginRight="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif"
            tools:text="32"
            tools:ignore="UnusedAttribute"
            />

        <TextView
            android:id="@+id/event_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/event_bg"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="#CC000000"
            tools:text="My Awesome Event with a long long title!"
            />

        <TextView
            android:id="@+id/action_favourite"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:drawableLeft="@drawable/ic_favorite_grey600_24dp"
            android:drawableStart="@drawable/ic_favorite_grey600_24dp"
            android:layout_below="@+id/event_bg"
            android:drawablePadding="4dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_alignBaseline="@+id/event_title"
            android:textColor="#FF595959"
            />

        <TextView
            android:id="@+id/action_favourited"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:drawableLeft="@drawable/ic_favorite_red_24dp"
            android:drawableStart="@drawable/ic_favorite_red_24dp"
            android:layout_below="@+id/event_bg"
            android:drawablePadding="4dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_alignBaseline="@+id/event_title"
            android:textColor="#FF595959"
            />

        <TextView
            style="@style/EventCardText"
            android:id="@+id/event_venue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/event_title"
            android:layout_toLeftOf="@+id/event_travel_time"
            android:layout_toStartOf="@+id/event_travel_time"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:drawableStart="@drawable/ic_location_on_grey600_12dp"
            android:drawableLeft="@drawable/ic_location_on_grey600_12dp"
            tools:text="Jagriti theatre, Whitefield"
            />

        <TextView
            style="@style/EventCardText"
            android:id="@+id/event_travel_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/event_venue"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="6dp"
            android:layout_marginRight="6dp"
            android:drawableStart="@drawable/ic_local_taxi_grey600_12dp"
            android:drawableLeft="@drawable/ic_local_taxi_grey600_12dp"
            tools:text="30 mins"
            />

        <TextView
            android:id="@+id/event_time"
            style="@style/EventCardText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/event_venue"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginTop="2dp"
            android:paddingBottom="8dp"
            android:drawableStart="@drawable/ic_access_time_grey600_12dp"
            android:drawableLeft="@drawable/ic_access_time_grey600_12dp"
            tools:text="Sun, 29 Mar at 8:30 pm"
            />

    </RelativeLayout>
</android.support.v7.widget.CardView>
