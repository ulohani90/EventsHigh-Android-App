<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
                                    xmlns:card_view="http://schemas.android.com/apk/res-auto"
                                    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?android:attr/selectableItemBackground"
    android:descendantFocusability="blocksDescendants"
    card_view:cardCornerRadius="2dp"
    tools:layout_width="280dp"
>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
    >
        <com.eventshigh.nearme.app.view.FadeInNetworkImageView
            android:id="@+id/offer_image"
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignBottom="@+id/offer_action"
            android:layout_centerVertical="true"
            android:adjustViewBounds="false"
        />

        <TextView
            android:id="@+id/offer_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            android:layout_toRightOf="@+id/offer_image"
            android:layout_toEndOf="@+id/offer_image"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:textSize="14sp"
            android:textColor="#CC000000"
            tools:text="Win Booksmyshow Pass worth Rs. 100/-"
        />

        <TextView
            android:id="@+id/offer_action"
            style="@style/EHButtonCTATransparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/offer_message"
            tools:text="Claim"
        />
    </RelativeLayout>
    <TextView
        android:id="@+id/expired"
        style="?android:attr/textAppearanceMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="40dp"
        android:paddingRight="40dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="-40dp"
        android:layout_marginStart="-40dp"
        android:rotation="-45"
        android:textColor="@android:color/white"
        android:background="@android:color/holo_red_light"
        android:fontFamily="sans-serif-medium"
        android:text="@string/ui_offer_expired"
        android:visibility="gone"
        tools:ignore="UnusedAttribute"
    />
</android.support.v7.widget.CardView>
