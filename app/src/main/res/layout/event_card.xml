<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/selector_event_card"
    android:descendantFocusability="blocksDescendants"
>

    <com.android.volley.toolbox.NetworkImageView
        android:id="@+id/event_bg"
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignBottom="@+id/event_time"
        android:layout_centerVertical="true"
        android:background="#4b000000"
    />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignLeft="@+id/event_bg"
        android:layout_alignStart="@+id/event_bg"
        android:layout_alignRight="@+id/event_bg"
        android:layout_alignEnd="@+id/event_bg"
        android:layout_alignTop="@+id/event_bg"
        android:layout_alignBottom="@+id/event_bg"
        android:background="#4b000000"
    />

    <ImageView
        android:id="@+id/event_recommended"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_alignBottom="@+id/event_bg"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="4dp"
        android:src="@drawable/eh_recommend"
        tools:ignore="ContentDescription"
    />

    <TextView
        android:id="@+id/num_people_interested"
        style="@style/EventCardText"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:layout_alignBottom="@+id/event_bg"
        android:layout_alignRight="@+id/event_bg"
        android:layout_alignEnd="@+id/event_bg"
        android:textColor="@android:color/white"
        android:drawableStart="@drawable/event_card_person"
        android:drawableLeft="@drawable/event_card_person"
        android:layout_marginRight="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        tools:text="32"
    />

    <TextView
        android:id="@+id/event_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        android:layout_toRightOf="@+id/event_bg"
        android:layout_toEndOf="@+id/event_bg"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:maxLines="2"
        android:minLines="2"
        android:ellipsize="end"
        android:textSize="14sp"
        tools:text="My Awesome Event with a long long title!"
    />

    <TextView
        style="@style/EventCardText"
        android:id="@+id/event_venue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/event_title"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        android:layout_toRightOf="@+id/event_bg"
        android:layout_toEndOf="@+id/event_bg"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:drawableStart="@drawable/event_card_place"
        android:drawableLeft="@drawable/event_card_place"
        android:fontFamily="sans-serif-medium"
        tools:text="Jagriti theatre, Whitefield"
        tools:ignore="UnusedAttribute"
    />

    <TextView
        android:id="@+id/event_time"
        style="@style/EventCardText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/event_venue"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        android:layout_toRightOf="@+id/event_bg"
        android:layout_toEndOf="@+id/event_bg"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="2dp"
        android:paddingBottom="8dp"
        android:drawableStart="@drawable/event_card_time"
        android:drawableLeft="@drawable/event_card_time"
        android:fontFamily="sans-serif-medium"
        tools:text="Sun, 29 Mar at 8:30 pm"
        tools:ignore="UnusedAttribute"
    />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/event_time"
        android:baselineAligned="false"
        android:showDividers="middle"
        android:divider="@drawable/vertical_divider"
    >
        <FrameLayout
            android:id="@+id/action_favourite"
            style="@style/EventDetailButton"
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:layout_weight="1"
        >
            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:layout_gravity="center"
                android:drawableLeft="@drawable/ic_favourite_normal"
                android:drawableStart="@drawable/ic_favourite_normal"
                android:drawablePadding="4dp"
                android:text="Favourite"
            />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/action_dismiss"
            style="@style/EventDetailButton"
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:layout_weight="1"
        >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawableLeft="@drawable/ic_dismiss"
                android:drawableStart="@drawable/ic_dismiss"
                android:drawablePadding="4dp"
                android:text="Dismiss"
            />
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
