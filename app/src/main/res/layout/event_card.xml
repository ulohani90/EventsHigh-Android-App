<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/abc_text_size_body_1_material"
>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/abc_dropdownitem_text_padding_left"
        android:id="@+id/event_catergory"
        android:textSize="@dimen/abc_text_size_display_1_material"
        android:textColor="@color/day_selector_color"
        android:layout_gravity="center_vertical"
    />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
    >

        <TextView
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/abc_text_size_body_1_material"
            android:id="@+id/event_title"
        />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/event_locality"
        />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
        >

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/event_time"
            />
            <ImageView
                android:padding="@dimen/abc_dropdownitem_text_padding_left"
                android:layout_width="@dimen/abc_text_size_body_1_material"
                android:layout_height="@dimen/abc_text_size_body_1_material"
                android:src="@drawable/eh_popularity_icon_details_page"
                android:contentDescription="@string/num_people_interested"
            />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/num_people_interested"
            />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
