<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent_scrollview"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".activity.PhoneLoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/top_progress_bar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-4dp"
            android:layout_marginTop="-4dp"
            android:gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/eh_logo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_launcher"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <RelativeLayout
            android:id="@+id/phone_no_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"
            android:layout_marginTop="18dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/phone_no_info_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginBottom="12dp"
                android:drawablePadding="8dp"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:text="@string/ui_phone_verify_pa"
                android:textSize="18sp"
                tools:ignore="UnusedAttribute" />

            <android.support.design.widget.TextInputLayout
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginLeft="48dp"
                android:layout_below="@+id/phone_no_info_message">

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/ui_enter_name_hint"
                    android:inputType="textPersonName" />
            </android.support.design.widget.TextInputLayout>

            <TextView
                android:id="@+id/name_hint"
                style="?android:attr/textAppearanceSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/name"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="24dp"
                android:layout_marginTop="-8dp"
                android:gravity="center"
                android:text="(Your name is visible to your friends)"
                android:textSize="10sp"
                tools:ignore="HardcodedText,SmallSp" />

            <LinearLayout
                android:id="@+id/phone_et_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/name_hint"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/plus_91"
                    style="?android:attr/textAppearanceMedium"
                    android:layout_width="48dp"
                    android:layout_height="32dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:text="+91"
                    android:textSize="18sp"
                    tools:ignore="HardcodedText" />

                <android.support.design.widget.TextInputLayout
                    android:id="@+id/phone_no"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_below="@+id/name_hint"
                    android:layout_toEndOf="@+id/plus_91"
                    android:gravity="center">

                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ui_enter_phone_number_hint"
                        android:inputType="phone"
                        android:maxLength="10"
                        tools:ignore="TextFields" />
                </android.support.design.widget.TextInputLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/send_code"
                style="@style/EHButtonCTA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"

                android:layout_below="@+id/phone_et_layout"
                android:onClick="sendCode"
                android:text="@string/action_register" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/code_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/code_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_code"
                android:textSize="18sp" />

            <android.support.design.widget.TextInputLayout
                android:id="@+id/code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="0123456789"
                    android:hint="Your Code"
                    android:inputType="numberDecimal"
                    tools:ignore="HardcodedText" />
            </android.support.design.widget.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/change_number"
                    style="@style/EHButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="changeNumber"
                    android:text="@string/action_retry" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/verify_code"
                    style="@style/EHButtonCTA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="verifyCode"
                    android:text="@string/action_verify_code" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/verified_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/verified"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:layout_marginTop="24dp"
                android:text="@string/ui_code_verified"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/change_number_2"
                style="@style/EHButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="changeNumber"
                android:text="@string/action_change_no" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>