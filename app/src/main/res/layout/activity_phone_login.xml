<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".activity.PhoneLoginActivity"
>
    <ImageView
        android:id="@+id/eh_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:src="@drawable/eh_logo_with_text"
        tools:ignore="ContentDescription"
    />

    <TextView
        android:id="@+id/phone_no_label"
        style="?android:attr/textAppearanceLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:layout_below="@+id/eh_logo"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:text="Phone No"
    />

    <EditText
        android:id="@+id/phone_no"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:layout_below="@+id/eh_logo"
        android:layout_toRightOf="@+id/phone_no_label"
        android:inputType="phone"
    />


    <TextView
        android:id="@+id/code_label"
        style="?android:attr/textAppearanceLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:layout_below="@+id/phone_no_label"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:text="Code"
    />

    <EditText
        android:id="@+id/code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:layout_below="@+id/phone_no"
        android:layout_toRightOf="@+id/phone_no_label"
        android:inputType="numberDecimal"
        android:enabled="false"
    />

    <TextView
        android:id="@+id/send_code"
        style="@style/EventDetailButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:layout_below="@+id/code_label"
        android:layout_centerHorizontal="true"
        android:text="Send Code"
        android:onClick="sendCode"
    />
    <TextView
        android:id="@+id/verify_code"
        style="@style/EventDetailButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:layout_below="@+id/code_label"
        android:layout_centerHorizontal="true"
        android:text="Verify Code"
        android:onClick="verifyCode"
        android:visibility="gone"
    />
</RelativeLayout>
