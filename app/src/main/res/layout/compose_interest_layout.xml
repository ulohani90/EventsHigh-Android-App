<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/interest_selected_tag_bg"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/interest_name"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center"
        android:paddingLeft="12dp"
        android:paddingRight="8dp"
        android:text="Music"
        android:textColor="#353535"
        android:textSize="12sp" />

    <View
        android:id="@+id/tag_separator"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/category_tag_separator_color" />

    <ImageView
        android:id="@+id/follow_cancel"
        android:layout_width="32dp"
        android:layout_height="33dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_cancel_white_bg_24" />
</LinearLayout>