<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
>
    <com.eventshigh.nearme.app.view.FadeInNetworkImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="@dimen/explore_card_width"
        android:scaleType="centerCrop"
        android:adjustViewBounds="false"
    />
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_film"
        android:padding="10dp"
        android:gravity="bottom|start"
        android:fontFamily="sans-serif-medium"
        android:textSize="14sp"
        android:minLines="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@android:color/white"
        tools:text="Hip Hop Music"
    />
    <ImageView
        android:id="@+id/follow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="8dp"
        android:src="@drawable/ic_favorite_white_18dp"/>
</FrameLayout>
