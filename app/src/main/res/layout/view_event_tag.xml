<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
>
    <TextView
        android:id="@+id/tag_name"
        style="?android:attr/textAppearanceSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:textColor="@color/link_color"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_gravity="start|center_vertical"
        android:textIsSelectable="false"
        tools:text="Comedy"
    />
    <TextView
        android:id="@+id/following_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/eh_oval"
        android:drawableStart="@drawable/ic_done_white_12dp"
        android:drawableLeft="@drawable/ic_done_white_12dp"
        android:drawablePadding="4dp"
        android:textStyle="bold"
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:text="@string/ui_following"
        tools:ignore="SmallSp"
    />
    <TextView
        android:id="@+id/follow_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/eh_oval"
        android:drawablePadding="4dp"
        android:textStyle="bold"
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:text="@string/ui_follow"
        tools:ignore="SmallSp"
    />
</LinearLayout>
