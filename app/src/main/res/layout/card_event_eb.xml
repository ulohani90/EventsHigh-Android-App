<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
                                    xmlns:card_view="http://schemas.android.com/apk/res-auto"
                                    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:foreground="?android:attr/selectableItemBackground"
    card_view:cardCornerRadius="0dp"
    card_view:cardElevation="1dp"
    tools:context=".activity.EventsGridActivity"
>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
    >
        <TextView
            android:id="@+id/event_header"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_alignParentTop="true"
            android:background="@color/gray400"
            android:gravity="center_vertical|end"
            android:paddingRight="16dp"
            android:paddingEnd="16dp"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            tools:text="Tue, Apr 5"
        />

        <com.eventshigh.nearme.app.view.PaletteImageView
            android:id="@+id/event_bg"
            android:layout_width="@dimen/event_card_eb_width"
            android:layout_height="@dimen/event_card_eb_height"
            android:layout_margin="16dp"
            android:adjustViewBounds="false"
            android:scaleType="centerCrop"
            android:elevation="4dp"
            android:padding="2dp"
            tools:background="@color/gray200"
            tools:ignore="UnusedAttribute"
        />

        <TextView
            android:id="@+id/event_title"
            style="?android:attr/textAppearanceMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/event_bg"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:minLines="2"
            android:maxLines="2"
            android:textColor="#AA000000"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="My Awesome Event with a long long title which spans two lines!"
        />

        <TextView
            android:id="@+id/event_time"
            style="@style/EventCardEbText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/event_title"
            android:layout_toLeftOf="@+id/event_price"
            android:layout_toStartOf="@+id/event_price"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:drawableLeft="@drawable/ic_access_time_grey600_12dp"
            android:drawableStart="@drawable/ic_access_time_grey600_12dp"
            tools:text="8:30 pm"
        />

        <TextView
            android:id="@+id/event_price"
            style="@style/EventCardEbText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_below="@id/event_title"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp"
            tools:text="₹ 200 - 500"
        />

        <TextView
            android:id="@+id/event_venue"
            style="@style/EventCardEbText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/event_time"
            android:layout_toLeftOf="@+id/event_travel_time"
            android:layout_toStartOf="@+id/event_travel_time"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="6dp"
            android:drawableLeft="@drawable/ic_location_on_grey600_12dp"
            android:drawableStart="@drawable/ic_location_on_grey600_12dp"
            tools:text="Jagriti theatre, Whitefield"
        />

        <TextView
            android:id="@+id/event_travel_time"
            style="@style/EventCardEbText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_below="@id/event_time"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp"
            android:drawableLeft="@drawable/ic_local_taxi_grey600_12dp"
            android:drawableStart="@drawable/ic_local_taxi_grey600_12dp"
            tools:text="30 mins"
        />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/event_venue"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:background="@color/gray400"
        />

        <ImageView
            android:id="@+id/action_favourite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_below="@+id/divider"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/eh_circle_button"
            android:padding="8dp"
            android:src="@drawable/ic_favorite_red_24dp"
        />
        <ImageView
            android:id="@+id/share_whatsapp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/divider"
            android:layout_toLeftOf="@+id/action_favourite"
            android:layout_toStartOf="@+id/action_favourite"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp"
            android:gravity="center"
            android:padding="8dp"
            android:src="@drawable/whatsapp_24dp"
            android:background="@drawable/button_whatsapp"
        />
        <ImageView
            android:id="@+id/share_fb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/share_whatsapp"
            android:layout_toStartOf="@+id/share_whatsapp"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp"
            android:layout_below="@+id/divider"
            android:gravity="center"
            android:padding="10dp"
            android:src="@drawable/com_facebook_inverse_icon"
            android:background="@drawable/button_fb"
        />
    </RelativeLayout>
</android.support.v7.widget.CardView>
