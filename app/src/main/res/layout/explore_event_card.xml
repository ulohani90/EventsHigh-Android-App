<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
                                    xmlns:tools="http://schemas.android.com/tools"
                                    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/event_card_width"
    android:layout_height="@dimen/event_card_height"
    android:foreground="?android:attr/selectableItemBackground"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:layout_marginLeft="2dp"
    android:layout_marginStart="2dp"
    android:layout_marginRight="10dp"
    android:layout_marginEnd="10dp"
    card_view:cardCornerRadius="4dp"
    card_view:cardElevation="4dp"
>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
    >
        <com.android.volley.toolbox.NetworkImageView
            android:id="@+id/event_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="false"
        />
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_film"
        />
        <ImageView
            android:id="@+id/event_recommended"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_above="@+id/event_title"
            android:layout_margin="8dp"
            android:src="@drawable/eh_recommend"
            tools:ignore="ContentDescription"
        />
        <ImageView
            android:id="@+id/event_offer_marker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_local_offer_white_24dp"
            android:layout_above="@+id/event_title"
            android:layout_toRightOf="@+id/event_recommended"
            android:layout_toEndOf="@+id/event_recommended"
            android:layout_margin="8dp"
        />
        <TextView
            android:id="@+id/event_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginRight="36dp"
            android:layout_marginEnd="36dp"
            android:layout_marginBottom="2dp"
            android:layout_marginTop="2dp"
            android:layout_alignParentBottom="true"
            android:textStyle="bold"
            android:textSize="17sp"
            android:minLines="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@android:color/white"
            tools:text="This is example of event title - which is really really long one"
        />
        <ImageView
            android:id="@+id/action_favourite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            android:layout_alignBottom="@+id/event_bg"
            android:src="@drawable/ic_favorite_white_24dp"
            android:clickable="true"
        />
        <ImageView
            android:id="@+id/action_favourited"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            android:layout_alignBottom="@+id/event_bg"
            android:src="@drawable/ic_favorite_red_24dp"
            android:clickable="true"
        />
    </RelativeLayout>
</android.support.v7.widget.CardView>
