<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="EventsActionBar" parent="android:Widget.Holo.Light.ActionBar.Solid.Inverse">
        <item name="android:background">@color/app_color</item>
        <item name="android:backgroundSplit">@color/app_color</item>
    </style>
    <style name="AppTheme" parent="android:Theme.Holo.Light.DarkActionBar">
        <item name="android:actionBarStyle">@style/EventsActionBar</item>
    </style>

    <!-- Theme used for Events Details Pane -->
    <style name="EventDetailText" parent="android:style/TextAppearance.Small">
        <item name="android:paddingLeft">@dimen/abc_dropdownitem_text_padding_left</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">@dimen/abc_text_size_caption_material</item>
        <item name="android:typeface">serif</item>
    </style>

    <style name="EventDetailHeader" parent="android:style/TextAppearance.Medium">
        <item name="android:padding">@dimen/abc_dropdownitem_text_padding_left</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">@dimen/abc_text_size_body_1_material</item>
        <item name="android:typeface">sans</item>
    </style>

    <!-- Theme used for Events Details Action Icons -->
    <style name="EventActionMenuItem" parent="android:style/TextAppearance.Widget.IconMenu.Item">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textSize">@dimen/abc_text_size_body_1_material</item>
        <item name="android:padding">@dimen/abc_control_padding_material</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- Theme used for Events Cards -->
    <style name="EventCardText" parent="android:style/TextAppearance.Small">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginLeft">@dimen/abc_dropdownitem_text_padding_right</item>
        <item name="android:layout_marginRight">@dimen/abc_dropdownitem_text_padding_right</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="EventTagText" parent="EventCardText">
        <item name="android:background">@drawable/rounded_bg</item>
        <item name="android:paddingLeft">@dimen/abc_control_padding_material</item>
        <item name="android:paddingRight">@dimen/abc_control_padding_material</item>
    </style>

</resources>
