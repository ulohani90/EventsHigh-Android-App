<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="EHActionBarSubtitle" parent="android:TextAppearance.Holo.Widget.ActionBar.Subtitle.Inverse">
        <item name="android:textColor">#80FFFFFF</item>
    </style>
    <style name="EHActionBar" parent="android:Widget.Holo.Light.ActionBar.Solid.Inverse">
        <item name="android:background">@color/app_color</item>
        <item name="subtitleTextStyle">@style/EHActionBarSubtitle</item>
    </style>
    <style name="AppTheme" parent="android:Theme.Holo.Light.DarkActionBar">
        <item name="android:actionBarStyle">@style/EHActionBar</item>
        <item name="android:colorPrimaryDark" tools:ignore="NewApi">@color/app_color</item>
    </style>

    <!-- Theme used for Events Details Pane -->
    <style name="EventDetailText" parent="android:style/TextAppearance.Small">
        <item name="android:paddingLeft">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="EventDetailHeader" parent="EventDetailText">
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:typeface">sans</item>
    </style>

    <style name="EventDetailButton" parent="android:style/TextAppearance.Small">
        <item name="android:clickable">true</item>
        <item name="android:padding">18dp</item>
        <item name="android:background">@drawable/selector_button</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <!-- Theme used for Events Cards -->
    <style name="EventCardText" parent="android:style/TextAppearance.Small">
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">11sp</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:fontFamily" tools:ignore="NewApi">sans-serif-medium</item>
        <item name="android:textColor">#7A212121</item>
    </style>

    <!-- Themes used by Onboarding widgets powered by showcase library -->
    <style name="ShowcaseTheme" parent="ShowcaseView">
        <item name="sv_backgroundColor">#99000000</item>
        <item name="sv_detailTextAppearance">@style/ShowcaseCustomTitle</item>
    </style>

    <style name="ShowcaseCustomTitle" parent="TextAppearance.ShowcaseView.Title">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="EventTitle">
        <item name="android:textColor">@color/gray800</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily" tools:ignore="NewApi">sans-serif-light</item>
    </style>

</resources>
