<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="EHActionBarSubtitle" parent="android:TextAppearance.Holo.Widget.ActionBar.Subtitle.Inverse">
        <item name="android:textColor">#80FFFFFF</item>
    </style>
    <style name="EHActionBar" parent="Widget.AppCompat.Light.ActionBar.Solid.Inverse">
        <item name="android:background">@color/primary</item>
        <item name="subtitleTextStyle">@style/EHActionBarSubtitle</item>
    </style>
    <style name="EHActionBarDark" parent="@style/ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:background">@color/primary</item>
    </style>
    <style name="EHFollowActionBar" parent="@style/ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:dropDownListViewStyle">@style/DropDownListView</item>
    </style>
    <style name="DropDownListView" parent="@android:style/Widget.Holo.ListView.DropDown">
        <item name="android:background">@color/primary</item>
    </style>
    <style name="EHActionBarBig" parent="@style/ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="EHActionBarNoElevation" parent="EHActionBar">
        <item name="elevation" tools:ignore="NewApi">0dp</item>
    </style>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="actionBarStyle">@style/EHActionBar</item>
    </style>
    <style name="AppThemeNoElevation" parent="AppTheme">
        <item name="actionBarStyle">@style/EHActionBarNoElevation</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!-- Theme used for Events Details Pane -->
    <style name="EHText" parent="android:style/TextAppearance.Small">
        <item name="android:paddingLeft">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="EHHeader" parent="EHText">
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:typeface">sans</item>
    </style>

    <style name="EHButton" parent="android:style/TextAppearance.Small">
        <item name="android:clickable">true</item>
        <item name="android:padding">18dp</item>
        <item name="android:background">@drawable/eh_button</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="EHButtonCTA" parent="EHButton">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily" tools:ignore="NewApi">sans-serif-medium"</item>
        <item name="android:background">@drawable/eh_button_cta</item>
    </style>
    <style name="EHDetailActionButton" parent="android:style/TextAppearance.Small">
        <item name="android:background">@drawable/eh_button</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <!-- Theme used for Events Cards -->
    <style name="EventCardText" parent="android:style/TextAppearance.Small">
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">11sp</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:fontFamily" tools:ignore="NewApi">sans-serif-medium</item>
        <item name="android:textColor">#99212121</item>
    </style>

    <!-- Theme used for EB Events Cards -->
    <style name="EventCardEbText" parent="android:style/TextAppearance.Small">
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">13sp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:fontFamily" tools:ignore="NewApi">sans-serif</item>
        <item name="android:textColor">#99212121</item>
    </style>

    <style name="RateText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@android:color/black</item>
    </style>
</resources>
