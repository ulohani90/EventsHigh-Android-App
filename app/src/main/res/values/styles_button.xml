<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="EHButton" parent="android:style/TextAppearance.Small">
        <item name="android:clickable">true</item>
        <item name="android:padding">18dp</item>
        <item name="android:background">@drawable/eh_button</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="EHButtonCTA" parent="EHButton">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily" tools:ignore="NewApi">sans-serif-medium</item>
        <item name="android:background">@drawable/eh_button_cta</item>
    </style>
    <style name="EHButtonCTATransparent" parent="EHButton">
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>
    <style name="EHDetailActionButton" parent="android:style/TextAppearance.Small">
        <item name="android:background">@drawable/eh_button</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <style name="ButtonTransparentDark">
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/gray700</item>
        <item name="android:background">@drawable/button_transparent_dark</item>
    </style>

</resources>
