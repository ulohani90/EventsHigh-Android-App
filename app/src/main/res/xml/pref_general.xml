<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <Preference android:title="@string/pref_title_offers">
        <intent
            android:targetPackage="com.eventshigh.nearme.app"
            android:targetClass="com.eventshigh.nearme.app.activity.OffersActivity"
        />
    </Preference>

    <Preference
        android:key="points_key"
        android:title="@string/pref_title_points"
        android:summary="0" />

    <Preference android:title="@string/pref_title_add_event" android:summary="listings@eventshigh.com">
        <intent
            android:targetPackage="com.eventshigh.nearme.app"
            android:targetClass="com.eventshigh.nearme.app.activity.SettingsActivity"
            android:action="com.eventshigh.add_event"
        />
    </Preference>
    <Preference android:title="@string/pref_title_send_feedback" android:summary="support@eventshigh.com">
        <intent
            android:targetPackage="com.eventshigh.nearme.app"
            android:targetClass="com.eventshigh.nearme.app.activity.FeedbackActivity"
        />
    </Preference>
    <Preference android:title="@string/pref_title_about_us">
        <intent
            android:targetPackage="com.eventshigh.nearme.app"
            android:targetClass="com.eventshigh.nearme.app.activity.AboutUsActivity"
        />
    </Preference>

</PreferenceScreen>
