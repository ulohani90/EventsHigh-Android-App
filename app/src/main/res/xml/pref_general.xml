<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <ListPreference
        android:key="last_city_key"
        android:title="@string/pref_title_change_location"
    />
    <Preference android:title="@string/pref_title_phone_no">
        <intent
            android:targetPackage="com.eventshigh.nearme.app"
            android:targetClass="com.eventshigh.nearme.app.activity.PhoneLoginActivity"
        />
    </Preference>
    <Preference android:title="@string/title_blog">
        <intent
            android:targetPackage="com.eventshigh.nearme.app"
            android:targetClass="com.eventshigh.nearme.app.activity.BlogFeedActivity"
        />
    </Preference>
    <Preference android:title="@string/title_refer">
        <intent
            android:targetPackage="com.eventshigh.nearme.app"
            android:targetClass="com.eventshigh.nearme.app.activity.ReferralActivity"
        />
    </Preference>

    <Preference android:title="@string/pref_title_about_us">
        <intent
            android:targetPackage="com.eventshigh.nearme.app"
            android:targetClass="com.eventshigh.nearme.app.activity.AboutUsActivity"
        />
    </Preference>
</PreferenceScreen>
