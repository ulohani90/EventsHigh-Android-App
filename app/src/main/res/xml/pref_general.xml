<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <ListPreference
        android:key="default_activity"
        android:title="@string/pref_title_default_activity"
        android:defaultValue="list"
        android:entries="@array/pref_default_activity_titles"
        android:entryValues="@array/pref_default_activity_values"
        android:negativeButtonText="@null"
        android:positiveButtonText="@null"
    />
    <Preference android:title="@string/pref_title_refer">
        <intent
            android:targetPackage="com.eventshigh.nearme.app"
            android:targetClass="com.eventshigh.nearme.app.activity.ShareAppActivity"
        />
    </Preference>
    <Preference android:title="@string/pref_title_about_us">
        <intent
            android:targetPackage="com.eventshigh.nearme.app"
            android:targetClass="com.eventshigh.nearme.app.settings.AboutUsActivity"
        />
    </Preference>

</PreferenceScreen>
