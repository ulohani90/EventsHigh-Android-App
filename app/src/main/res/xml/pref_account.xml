<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <Preference android:title="@string/pref_title_phone_no">
        <intent
            android:targetPackage="com.eventshigh.nearme.app"
            android:targetClass="com.eventshigh.nearme.app.activity.PhoneLoginActivity"
        />
    </Preference>
    <Preference android:title="@string/pref_title_delete_query_history">
        <intent
            android:targetPackage="com.eventshigh.nearme.app"
            android:targetClass="com.eventshigh.nearme.app.activity.SettingsActivity"
            android:action="com.eventshigh.delete_query_history"
        />
    </Preference>
</PreferenceScreen>
