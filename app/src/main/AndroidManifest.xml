<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
    package="com.eventshigh.nearme.app"
    android:installLocation="auto"
>
    <!-- Ask for permissions, we need internet access and Google Maps access -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".application.EHApplication"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        tools:ignore="AllowBackup"
    >
        <!-- Setup the search activity -->
        <meta-data
            android:name="android.app.searchable"
            android:resource="@xml/searchable"
        />
        <meta-data
            android:name="android.app.default_searchable"
            android:value=".activity.LaunchActivity"
        />

        <!--Branch.io-->
        <meta-data android:name="io.branch.sdk.BranchKey" android:value="key_live_nfj8qbtAAg1Hkj4K6jszCnfkwCgwGUL4" />

        <!--Glide -->
        <meta-data
            android:name="com.bumptech.glide.integration.volley.VolleyGlideModule"
            android:value="GlideModule"
        />

        <!-- Enable the search recent suggestion provider -->
        <provider
            android:authorities="com.eventshigh.nearme.app.EventSearchSuggestions"
            android:name=".ui.EventSearchSuggestionsProvider"
            android:exported="true"
            android:grantUriPermissions="true"
            android:readPermission="com.eventshigh.nearme.app.provider.READ_MY_DATA"
            android:writePermission="com.eventshigh.nearme.app.provider.WRITE_MY_DATA"
        >
            <path-permission
                android:pathPrefix="/search_suggest_query"
                android:readPermission="android.permission.GLOBAL_SEARCH"
            />
        </provider>

        <!-- Activities within our application -->
        <activity
            android:name=".activity.LaunchActivity"
            android:label="@string/app_name"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:theme="@style/NoActionBar"
            android:screenOrientation="portrait"
            android:exported="true"
        >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter android:autoVerify="true"
                           tools:ignore="UnusedAttribute">
                <data
                    android:scheme="https"
                    android:host="www.eventshigh.com"
                    android:pathPrefix="/city"
                />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>

            <!-- Accept Search requests withing app -->
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
            </intent-filter>

            <!--Branch.io filters-->
            <intent-filter>
                <data android:scheme="http" android:host="branch.eventshigh.com" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>

            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable"
            />
        </activity>

        <activity
            android:name=".activity.EventsGridActivity"
            android:label="@string/app_name"
            android:theme="@style/NoActionBar"
            android:screenOrientation="portrait"
            android:exported="true"
        >
            <intent-filter android:autoVerify="true"
                           tools:ignore="UnusedAttribute">
                <data
                    android:scheme="https"
                    android:host="www.eventshigh.com"
                    android:pathPrefix="/bangalore"
                />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
            <intent-filter android:autoVerify="true"
                           tools:ignore="UnusedAttribute">
                <data
                    android:scheme="https"
                    android:host="www.eventshigh.com"
                    android:pathPrefix="/chennai"
                />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
            <intent-filter android:autoVerify="true"
                           tools:ignore="UnusedAttribute">
                <data
                    android:scheme="https"
                    android:host="www.eventshigh.com"
                    android:pathPrefix="/delhi"
                />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
            <intent-filter android:autoVerify="true"
                           tools:ignore="UnusedAttribute">
                <data
                    android:scheme="https"
                    android:host="www.eventshigh.com"
                    android:pathPrefix="/mumbai"
                />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
            <intent-filter android:autoVerify="true"
                           tools:ignore="UnusedAttribute">
                <data
                    android:scheme="https"
                    android:host="www.eventshigh.com"
                    android:pathPrefix="/Bangalore"
                    />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
            <intent-filter android:autoVerify="true"
                           tools:ignore="UnusedAttribute">
                <data
                    android:scheme="https"
                    android:host="www.eventshigh.com"
                    android:pathPrefix="/Chennai"
                    />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
            <intent-filter android:autoVerify="true"
                           tools:ignore="UnusedAttribute">
                <data
                    android:scheme="https"
                    android:host="www.eventshigh.com"
                    android:pathPrefix="/Delhi"
                    />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
            <intent-filter android:autoVerify="true"
                           tools:ignore="UnusedAttribute">
                <data
                    android:scheme="https"
                    android:host="www.eventshigh.com"
                    android:pathPrefix="/Mumbai"
                    />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
            <intent-filter android:autoVerify="true"
                           tools:ignore="UnusedAttribute">
                <data
                    android:scheme="https"
                    android:host="www.eventshigh.com"
                    android:pathPrefix="/search"
                />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.BlogFeedActivity"
            android:label="@string/title_blog"
            android:screenOrientation="portrait"
            android:exported="true"
            android:parentActivityName=".activity.LaunchActivity"
        >
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.LaunchActivity"
            />
            <intent-filter android:autoVerify="true"
                           tools:ignore="UnusedAttribute">
                <data
                    android:scheme="https"
                    android:host="blog.eventshigh.com"
                    android:path="/"
                />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.BlogEntryActivity"
            android:label="@string/title_blog"
            android:theme="@style/NoActionBar"
            android:screenOrientation="portrait"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:parentActivityName=".activity.BlogFeedActivity"
        >
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.BlogFeedActivity"
            />
            <intent-filter android:autoVerify="true"
                           tools:ignore="UnusedAttribute">
                <data
                    android:scheme="https"
                    android:host="blog.eventshigh.com"
                    android:pathPrefix="/2"
                />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.EventDetailActivity"
            android:label="@string/app_name"
            android:theme="@style/NoActionBar"
            android:screenOrientation="portrait"
            android:exported="true"
            android:hardwareAccelerated="true"
        >
            <intent-filter android:autoVerify="true"
                           tools:ignore="UnusedAttribute">
                <data
                    android:scheme="https"
                    android:host="www.eventshigh.com"
                    android:pathPrefix="/detail"
                />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>

            <meta-data android:name="io.branch.sdk.auto_link_request_code" android:value="@integer/EventsDetailDeepLink_code" />

        </activity>

        <activity
            android:name=".activity.SelectInterestsActivity"
            android:label="@string/app_name"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:hardwareAccelerated="true"
            android:theme="@style/NoActionBar"
            />


        <activity
            android:name=".activity.CustomUrlActivity"
            android:label="@string/app_name"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:hardwareAccelerated="true"
            android:parentActivityName=".activity.EventDetailActivity"
        />
        <activity
            android:name=".activity.OnBoardingActivity"
            android:theme="@style/NoActionBar"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:noHistory="true"
        />
        <activity
            android:name=".activity.PhoneLoginActivity"
            android:label="@string/pref_title_phone_no"
            android:screenOrientation="portrait"
            android:parentActivityName=".activity.LaunchActivity"
        >
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.LaunchActivity"
            />
        </activity>
        <activity
            android:name=".activity.AboutUsActivity"
            android:label="@string/pref_title_about_us"
            android:launchMode="singleTask"
            android:parentActivityName=".activity.LaunchActivity"
        >
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.LaunchActivity"
            />
        </activity>
        <activity
            android:name=".activity.ReferralActivity"
            android:label="@string/title_refer"
            android:launchMode="singleTask"
            android:theme="@style/NoActionBar"
            android:hardwareAccelerated="false"
            android:parentActivityName=".activity.LaunchActivity"
        >
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.LaunchActivity"
            />
        </activity>

        <!-- Receivers within our application -->
        <!-- Receives the Install referrer from play store -->
        <receiver
            android:name=".broadcast.InstallReferrer"
            android:exported="true"
            tools:ignore="ExportedReceiver"
        >
            <intent-filter>
                <action android:name="com.android.vending.INSTALL_REFERRER" />
            </intent-filter>
        </receiver>

        <!-- Service to upload the account information to our servers -->
        <service
            android:name=".broadcast.UpdateAccountInfoService"
            android:exported="false">
        </service>
    </application>

</manifest>
  
